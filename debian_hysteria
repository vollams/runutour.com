install_monitoring(){
if ! command -v fastfetch >/dev/null 2>&1; then
    arch=$(dpkg --print-architecture)
    if [ "$arch" = "amd64" ]; then
        if ! command -v fastfetch >/dev/null 2>&1; then
    		wget 'https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-amd64.deb' -O /tmp/fastfetch.deb
			sudo dpkg -i /tmp/fastfetch.deb
		fi
    else
        echo "Unsupported architecture: $arch"
    fi
else
    echo "Fastfetch is already installed."
    fastfetch
fi

wget 'https://raw.githubusercontent.com/vollams/openvpn/refs/heads/main/n_monitor' -O /etc/.monitor
chmod +x /etc/.monitor
echo "mysql --ssl-verify-server-cert=OFF -u \$DB_USER -p\$DB_PASS -D \$DB_NAME -h \$DB_HOST --default-character-set=utf8mb4 -e \"UPDATE server_list SET status=1 WHERE server_ip='\$ip'\" 2>/dev/null" >> /etc/.monitor
}

