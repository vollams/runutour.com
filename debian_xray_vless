install_certificate(){
# ----- CHECK ROOT -----
if [[ $EUID -ne 0 ]]; then
   echo "❌ This script must be run as ROOT"
   exit 1
fi

# ----- UPDATE SYSTEM -----
apt update -y
apt install -y socat cron curl

# ----- INSTALL ACME.SH -----
echo "📦 Installing ACME.SH..."
curl https://get.acme.sh | sh

# Load acme.sh environment
source ~/.bashrc
source ~/.acme.sh/acme.sh.env 2>/dev/null

# ----- SET DEFAULT CA -----
~/.acme.sh/acme.sh --set-default-ca --server letsencrypt

# ----- REGISTER ACCOUNT -----
~/.acme.sh/acme.sh --register-account -m "$EMAIL"

# ----- ISSUE CERTIFICATE -----
echo "🔐 Issuing certificate for $DOMAIN ..."
~/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone

# ----- INSTALL CERTIFICATE -----
echo "📥 Installing certificate..."
~/.acme.sh/acme.sh --installcert -d "$DOMAIN" \
 --key-file /root/firenet.key \
 --fullchain-file /root/firenet.crt \
 --reloadcmd "systemctl restart xray" 2>/dev/null || true

# ----- FALLBACK: self-signed cert if acme.sh failed -----
if [ ! -f /root/firenet.crt ] || [ ! -s /root/firenet.crt ]; then
    echo "⚠️  acme.sh cert failed — generating self-signed certificate..."
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout /root/firenet.key \
        -out /root/firenet.crt \
        -subj "/C=PH/ST=Metro Manila/L=Manila/O=Firenet/OU=VPN/CN=${DOMAIN}" 2>/dev/null
    echo "✅ Self-signed cert generated. Replace with real cert after DNS is ready."
fi

# ----- FINAL RESULT -----
echo "============================================"
echo "✅ SSL Certificate Installed Successfully!"
echo " Domain     : $DOMAIN"
echo " Private Key: /root/firenet.key"
echo " Fullchain  : /root/firenet.crt"
echo "============================================"
}

