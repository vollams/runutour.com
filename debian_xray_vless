auto_create_dns(){
    echo "🔗 Creating DNS A record: $DOMAIN → $server_ip ..."

    if [ -z "$API_LINK" ] || [ -z "$API_KEY" ]; then
        echo "⚠️  API_LINK or API_KEY not set — skipping auto DNS, configure DNS manually."
        return 0
    fi

    DNS_RESPONSE=$(curl -s --max-time 20 \
        "${API_LINK}/auto_dns.php?key=${API_KEY}&domain=${DOMAIN}&ip=${server_ip}" 2>/dev/null)

    DNS_STATUS=$(echo "$DNS_RESPONSE" | grep -o '"response":[0-9]*' | grep -o '[0-9]*')
    DNS_MSG=$(echo "$DNS_RESPONSE" | grep -o '"msg":"[^"]*"' | sed 's/"msg":"//;s/"//')

    if [ "$DNS_STATUS" = "1" ]; then
        echo "✅ DNS: $DNS_MSG"
        echo "⏳ Waiting 45 seconds for DNS propagation..."
        sleep 45
    else
        echo "⚠️  DNS: $DNS_MSG — proceeding anyway (may already exist)."
        sleep 5
    fi
}

