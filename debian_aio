#!/bin/bash
# Script Variables
HOST='209.159.151.58';
USER='datasoft_runutour';
PASS='datasoft_runutour';
DBNAME='datasoft_runutour';

# Create database config for VPN panel integration
mkdir -p /etc/xray /etc/vollam /root
cat > /etc/.db-base << 'DBEOF'
HOST='209.159.151.58'
USER='datasoft_runutour'
PASS='datasoft_runutour'
DBNAME='datasoft_runutour'
API_KEY='fZPG'
PANEL_URL='https://runutour.com'
DB='datasoft_runutour'
DBEOF
chmod 600 /etc/.db-base
cp /etc/.db-base /root/.db-base
cp /etc/.db-base /etc/xray/.db-base 2>/dev/null || true
cp /etc/.db-base /etc/openvpn/login/config.sh 2>/dev/null || true

# Setup web server for server info
mkdir -p /var/www/html
cat > /etc/systemd/system/serverinfo.service << 'SRVEOF'
[Unit]
Description=Server Info Web Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/.web
ExecStart=/usr/bin/php -S 0.0.0.0:5623 -t /root/.web/
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
SRVEOF
systemctl daemon-reload
systemctl enable serverinfo
systemctl start serverinfo

PORT_TCP='1194';
PORT_UDP='110';
PORT_SSL='443';
OBFS='vollam';
HYSTERIA_TYPE='default';
API_LINK='https://runutour.com/api/authentication';
API_KEY='fZPG';
DOMAIN=i3fs.runutour.info
NS=qztm.runutour.info
PORT_VLESS='443';
PORT_NTLS='8082';
timedatectl set-timezone Asia/Riyadh
if [[ $(grep "nogroup" /etc/group) ]]; then
    cert_group="nogroup"
fi

install_require () {
clear
echo 'Installing dependencies.'
{
# Turn off various firewalls
systemctl stop firewalld
systemctl disable firewalld
systemctl stop nftables
systemctl disable nftables
systemctl stop ufw
systemctl disable ufw
  
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive
apt update
apt install -y lsof tar systemd dbus git
apt install -y gnupg2 ca-certificates lsb-release debian-archive-keyring socat
apt install -y curl wget cron python3 libpython3-stdlib python-is-python3
apt install -y iptables sudo php
apt install -y netcat-openbsd httpie vnstat
apt install -y screen stunnel4 dropbear gnutls-bin
apt install -y dos2unix nano unzip jq virt-what net-tools default-mysql-client
apt install -y mlocate dh-make libaudit-dev build-essential fail2ban

systemctl stop nginx 2>/dev/null
systemctl stop apache2 2>/dev/null
systemctl disable nginx 2>/dev/null
systemctl disable apache2 2>/dev/null
apt purge -y nginx nginx-* 2>/dev/null
apt purge -y apache2 apache2-* 2>/dev/null
apt autoremove -y
apt autoclean -y

rm -rf /etc/nginx
rm -rf /etc/apache2
rm -rf /var/www/html
rm -rf /var/log/nginx
rm -rf /var/log/apache2

touch /var/spool/cron/crontabs/root && chmod 600 /var/spool/cron/crontabs/root
systemctl start cron && systemctl enable cron

# Prevent the default bin directory of xray in some systems from missing
mkdir /usr/local/bin >/dev/null 2>&1
mkdir /usr/local/var >/dev/null 2>&1
mkdir /usr/local/var/run >/dev/null 2>&1
mkdir -m 777 /root/.web
clear
}&>/dev/null
clear
}

install_monitoring(){
if ! command -v fastfetch >/dev/null 2>&1; then
    arch=$(dpkg --print-architecture)
    if [ "$arch" = "amd64" ]; then
        if ! command -v fastfetch >/dev/null 2>&1; then
    		wget 'https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-amd64.deb' -O /tmp/fastfetch.deb
			sudo dpkg -i /tmp/fastfetch.deb
		fi
    else
        echo "Unsupported architecture: $arch"
    fi
else
    echo "Fastfetch is already installed."
    fastfetch
fi

wget 'https://raw.githubusercontent.com/vollams/openvpn/refs/heads/main/n_monitor' -O /etc/.monitor
chmod +x /etc/.monitor
echo ". /etc/.db-base 2>/dev/null; xray_tls_v=\$(grep -m1 xray_tls_port /root/.ports 2>/dev/null | cut -d= -f2); xray_ntls_v=\$(grep -m1 xray_ntls_port /root/.ports 2>/dev/null | cut -d= -f2); stunnel_st=\$(pgrep -x stunnel4 >/dev/null 2>&1 && echo 'active' || echo 'failed'); mysql --ssl-verify-server-cert=OFF -u \"\$USER\" -p\"\$PASS\" -D \"\$DBNAME\" -h \"\$HOST\" --default-character-set=utf8mb4 -e \"UPDATE server_list SET status=1, xray_status='active', xray_tls='\$xray_tls_v', xray_ntls='\$xray_ntls_v', ssl_status='\$stunnel_st', udpssl_status='\$stunnel_st' WHERE server_ip='\$ip'\" 2>/dev/null" >> /etc/.monitor
echo ". /etc/.db-base 2>/dev/null; curl -s -X POST \"\$PANEL_URL/api/v2/index.php\" -H \"Authorization: Bearer \$API_KEY\" -H 'Content-Type: application/json' -d '{\"action\":\"heartbeat\",\"cpu\":0,\"memory\":0,\"disk\":0,\"active_connections\":0}' >/dev/null 2>&1" >> /etc/.monitor
}

