install_ssl() {
    STOPWEBSERVER=$(lsof -ti:80 | head -n1)
    rm -rf /root/.acme.sh
    mkdir /root/.acme.sh
    systemctl stop "$STOPWEBSERVER"
    systemctl stop nginx
    curl http://repo.firenetvpn.com/script_files/acme.sh -o /root/.acme.sh/acme.sh
    chmod +x /root/.acme.sh/acme.sh
    /root/.acme.sh/acme.sh --upgrade --auto-upgrade
    /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt
    /root/.acme.sh/acme.sh --issue -d $DOMAIN --standalone -k ec-256
    ~/.acme.sh/acme.sh --installcert -d $DOMAIN --fullchainpath /etc/xray/xray.crt --keypath /etc/xray/xray.key --ecc
    chmod 777 /etc/xray/xray.key
    
    NGINX_VER=$(nginx -v 2>&1 | awk -F/ '{print $2}')
	if dpkg --compare-versions "$NGINX_VER" ge "1.27.0"; then
    wget -O /etc/nginx/conf.d/firenet.conf "https://raw.githubusercontent.com/bytronixdev/xfiles/refs/heads/main/firenet2.conf" >/dev/null 2>&1
    else
	wget -O /etc/nginx/conf.d/firenet.conf "https://raw.githubusercontent.com/bytronixdev/xfiles/refs/heads/main/firenet.conf" >/dev/null 2>&1
	fi
    
	sed -i "s/xxx/$DOMAIN/g" /etc/nginx/conf.d/firenet.conf
    wget -O /etc/nginx/nginx.conf "http://repo.firenetvpn.com/script_files/nginx.conf" >/dev/null 2>&1
    wget -O /etc/firenet/.version "http://repo.firenetvpn.com/script_files/version" >/dev/null 2>&1
    
    vnstat -u -i $NET
    sed -i 's/Interface "'""eth0""'"/Interface "'""$NET""'"/g' /etc/vnstat.conf
    chown vnstat:vnstat /var/lib/vnstat -R
    
}

