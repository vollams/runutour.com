install_xray(){
    domainSock_dir="/run/xray";! [ -d $domainSock_dir ] && mkdir  $domainSock_dir
    chown firenet.firenet $domainSock_dir
    chown firenet.firenet /var/log/xray
    
    echo "$DOMAIN" >> /etc/xray/domain
    
    curl -s ipinfo.io/city >> /etc/xray/city
    curl -s ipinfo.io/org | cut -d " " -f 2-10 >> /etc/xray/isp
    
    xray_latest="$(curl -s https://api.github.com/repos/dharak36/Xray-core/releases | grep tag_name | sed -E 's/.*"v(.*)".*/\1/' | head -n 1)"
    xraycore_link="http://repo.firenetvpn.com/script_files/release/xray"
    curl -sL "$xraycore_link" -o xray
    mv xray /usr/sbin/xray

    wget -O /etc/xray/xray_stats.sh "http://repo.firenetvpn.com/script_files/xray_stats.sh" >/dev/null 2>&1 
    chmod +x /etc/xray/xray_stats.sh
    wget -O /etc/xray/config.json "https://gitlab.com/vollam/dev/-/raw/main/xray_config.json" >/dev/null 2>&1 
    sed -i "s/xxxFirenetxxx/$UUID/g" /etc/xray/config.json
    
    # > Set Permission
    chmod +x /usr/sbin/xray

    # > Create Service
    cat >/etc/systemd/system/xray.service <<EOF
[Unit]
Description=Xray Service
Documentation=https://github.com/xtls
After=network.target nss-lookup.target

[Service]
User=firenet
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/sbin/xray run -config /etc/xray/config.json
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target

EOF
}

