  <script>
    // Copy function (works with inputs, code blocks, or divs)
    async function copyString(str){
      if(!str) return false;
      if(navigator.clipboard && navigator.clipboard.writeText){
        try{
          await navigator.clipboard.writeText(str);
          return true;
        }catch(e){
          // fallback below
        }
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = str;
        ta.setAttribute('readonly','');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch(e){
        return false;
      }
    }

    // Attach click handlers to copy buttons
    document.querySelectorAll('.copy-btn').forEach(btn=>{
      btn.addEventListener('click', async (e)=>{
        const rawSelector = btn.getAttribute('data-copy-raw'); // for copying pre blocks
        const targetId = btn.getAttribute('data-copy-target'); // for copying div/input
        let text = '';

        if(rawSelector){
          // copy text content of selector
          try{
            const node = document.querySelector(rawSelector);
            text = node ? node.textContent.trim() : '';
          }catch(err){
            text = '';
          }
        } else if(targetId){
          const el = document.getElementById(targetId);
          if(!el) return;
          // if input-like element
          if(el.value !== undefined){
            text = el.value;
          } else {
            text = el.textContent.trim();
          }
        } else {
          return;
        }

        const ok = await copyString(text);
        if(ok){
          // small animation on button
          const original = btn.innerText;
          btn.innerText = 'Copied!';
          setTimeout(()=> btn.innerText = original, 1200);
        } else {
          showToast('Copy failed — select and copy manually');
        }
      });
    });

    // Make link-text containers horizontally scrollable with drag on desktop
    document.querySelectorAll('.link-text').forEach(el=>{
      let isDown = false, startX, scrollLeft;
      el.addEventListener('mousedown', (e)=>{
        isDown = true;
        el.classList.add('active');
        startX = e.pageX - el.offsetLeft;
        scrollLeft = el.scrollLeft;
        e.preventDefault();
      });
      el.addEventListener('mouseleave', ()=> { isDown = false; el.classList.remove('active'); });
      el.addEventListener('mouseup', ()=> { isDown = false; el.classList.remove('active'); });
      el.addEventListener('mousemove', (e)=>{
        if(!isDown) return;
        const x = e.pageX - el.offsetLeft;
        const walk = (x - startX) * 1; // scroll-fast
        el.scrollLeft = scrollLeft - walk;
      });
    });

    // Allow keyboard copying: focusable
    document.querySelectorAll('.link-text, input.readonly, pre.format').forEach(el=>{
      el.setAttribute('tabindex','0');
    });
  </script>
